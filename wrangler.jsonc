{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imghost",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "secrets": {
    "required": ["ADMIN_USERNAME", "ADMIN_PASSWORD"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imghost-db",
      "database_id": "055c4ed9-f9da-4ad0-8d80-fe3541005567"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "imghost-images"
    }
  ]
}
